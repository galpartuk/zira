{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tcg-arena-app",
          "appId": "1:111644541949:android:649b4dbd15c8a4588f4f94",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/cloud/firebase_options.dart": {
          "projectId": "tcg-arena-app",
          "configurations": {
            "android": "1:111644541949:android:649b4dbd15c8a4588f4f94",
            "web": "1:111644541949:web:fc45af3a3655d1008f4f94"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|json|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}